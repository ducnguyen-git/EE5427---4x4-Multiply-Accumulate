load symbol temporary_object v IGEN pin S_AXI in pinprop iface {S_AXI.s_axi_araddr S_AXI.s_axi_arready S_AXI.s_axi_arvalid S_AXI.s_axi_awaddr S_AXI.s_axi_awready S_AXI.s_axi_awvalid S_AXI.s_axi_bready S_AXI.s_axi_bresp S_AXI.s_axi_bvalid S_AXI.s_axi_rdata S_AXI.s_axi_rready S_AXI.s_axi_rresp S_AXI.s_axi_rvalid S_AXI.s_axi_wdata S_AXI.s_axi_wready S_AXI.s_axi_wstrb S_AXI.s_axi_wvalid} pinfillcolor 5 pinimagedsp AXIMMLiteSlave -cc 0 0 10 16 pin S_AXI.s_axi_araddr in pinlinewidth 3 pin S_AXI.s_axi_arready out pinlinewidth 2 pin S_AXI.s_axi_arvalid in pinlinewidth 2 pin S_AXI.s_axi_awaddr in pinlinewidth 3 pin S_AXI.s_axi_awready out pinlinewidth 2 pin S_AXI.s_axi_awvalid in pinlinewidth 2 pin S_AXI.s_axi_bready in pinlinewidth 2 pin S_AXI.s_axi_bresp out pinlinewidth 3 pin S_AXI.s_axi_bvalid out pinlinewidth 2 pin S_AXI.s_axi_rdata out pinlinewidth 3 pin S_AXI.s_axi_rready in pinlinewidth 2 pin S_AXI.s_axi_rresp out pinlinewidth 3 pin S_AXI.s_axi_rvalid out pinlinewidth 2 pin S_AXI.s_axi_wdata in pinlinewidth 3 pin S_AXI.s_axi_wready out pinlinewidth 2 pin S_AXI.s_axi_wstrb in pinlinewidth 3 pin S_AXI.s_axi_wvalid in pinlinewidth 2 pin UART out pinprop iface {UART.rx UART.tx} pinfillcolor 5 pinimagedsp GenericMaster -cc 0 0 10 16 pin UART.rx in pinlinewidth 2 pin UART.tx out pinlinewidth 2 pin s_axi_aclk in pinlinewidth 3 pin s_axi_aresetn in.neg pinlinewidth 3 pin interrupt out pinlinewidth 3 fillcolor 5 centered
